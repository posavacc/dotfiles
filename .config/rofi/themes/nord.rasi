* {
  /* transparent */
  bg: #2E3440D9;
  fg: #ECEFF4D9;
  bg-alt: #3B4252D9;
  fg-alt: #D8DEE9D9;
  grey: #4C566AF2;
  nord8: #88C0D0;

  /* opaque
  bg: #000000;
  fg: #ffffff;
  bg-alt: #080808;
  fg-alt: #a6a6a6;
  grey: #383838;
  */

  background-color: @bg-alt;
  color: @fg-alt;

  border: 0;
  border-radius: 0;
  padding: 0;
  margin: 0;
  spacing: 0;
}

window {
  width: 32%;
}

inputbar {
  padding: 12px;
  spacing: 10px;
  children: [prompt, entry];
}

message {
  padding: 12px;
  background-color: @grey;
}

textbox {
  background-color: inherit;
}

prompt {
  text-color: @fg-alt;
  text-color: @nord8;
  background-color: inherit;
}

entry {
  text-color: @fg;
  placeholder: "";
  placeholder-color: @grey;
  background-color: inherit;
}

listview {
  lines: 3;
  fixed-height: false;
  scrollbar: false;
 // enabled: false;
}

element selected {
  background-color: @grey;
  text-color: @fg;
  text-color: @nord8;
}

element-icon {
  size: 30px;
  background-color: inherit;
}

element-text {
  background-color: inherit;
  text-color: inherit;
  vertical-align: 0.5;
}

element {
  padding: 12px;
  spacing: 12px;
}

mainbox,
inputbar,
listview,
textbox,
element,
element-text {
    background-color: transparent;
}

# ── Fonte ──────────────────────────────
font-family = JetBrainsMono Nerd Font Mono
font-size = 16
# "zero" = zero com barra/ponto
font-feature = zero

# ── Janela ─────────────────────────────
window-decoration = none
background-opacity = 1.0
confirm-close-surface = false

# ── Cursor ─────────────────────────────
cursor-style = block
cursor-style-blink = false
# mantém o cursor como bloco mesmo sem foco (o Ghostty usa oco por padrão)
# não há opção direta para isso; veja a nota abaixo

# ── Mouse ──────────────────────────────
mouse-hide-while-typing = true

# ── Shell integration ──────────────────
# no-cursor: mantém integração, mas não mexe no cursor
shell-integration = detect
shell-integration-features = no-cursor

# ── Open On Home ───────────────────────
working-directory = home
window-inherit-working-directory = false

# ── Bind ───────────────────────────────
keybind = ctrl+enter=unbind

# ── Áudio ──────────────────────────────
bell-features = no-audio

# ── Cores (Koda Palette) ───────────────

theme = Zenbones Dark

# background = #171717
# background = #1C1917
# foreground = #a6a6a6
# selection-foreground = #c4c4c4
# selection-background = #1a1a1a

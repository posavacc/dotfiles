font_size 16.0
enable_audio_bell no
hide_window_decorations yes
shell_integration no-cursor
cursor_shape block
cursor_shape_unfocused unchanged
cursor_trail 1
mouse_hide_wait -1


#font_family CommitMono Nerd Font Mono
#font_family Monocraft
# font_family Fira Code Nerd Font Mono
#FiraMonoNerdFontMono-Regular
#font_features FiraCodeNFM-Reg +cv02 +ss01 +ss05 +ss03
#font_features FiraCodeNFM-SemBd +cv02 +ss01 +ss05 +ss03
#font_features FiraCodeNFM-Ret +cv02 +ss01 +ss05 +ss03
#font_features FiraCodeNFM-SemBd +cv02 +ss01 +ss05 +ss03


font_family JetBrainsMono Nerd Font Mono
font_features JetBrainsMonoNFM-Regular zero
font_features JetBrainsMonoNFM-SemiBold zero
font_features JetBrainsMonoNFM-Italic zero
font_features JetBrainsMonoNFM-SemiBoldItalic zero



background_opacity 0.96
confirm_os_window_close 0

# ──────────────────────────────
#   COLORS — Koda Palette Dark Monochrome
# ──────────────────────────────
# background            #080808
# foreground            #a6a6a6
# selection_foreground  #c4c4c4
# selection_background  #1a1a1a
# cursor                #c4c4c4
# cursor_text_color     #080808
# url_color             #8a8a8a
# active_border_color   #1a1a1a
# inactive_border_color #121212

# ───────── ANSI

# black / base
# color0   #000000
# color8   #3d3d3d

# red / danger
# color1   #4a4a4a
# color9   #686868

# green
# color2   #5c5c5c
# color10  #a6a6a6

# yellow / warning
# color3   #666666
# color11  #b0b0b0

# blue / highlight
# color4   #707070
# color12  #b8b8b8

# magenta / pink
# color5   #7a7a7a
# color13  #d0d0d0

# cyan
# color6   #848484
# color14  #c0c0c0

# white / fg
# color7   #a6a6a6
# color15  #e0e0e0


# BEGIN_KITTY_FONTS
#font_family      family='FiraCode Nerd Font Mono' postscript_name=FiraCodeNFM-Reg
#bold_font        auto
#italic_font      auto
#bold_italic_font auto
# END_KITTY_FONTS


# BEGIN_KITTY_THEME
# Aquarium Dark
include current-theme.conf
# END_KITTY_THEME
background            #080808
foreground            #a6a6a6


prefer-no-csd

spawn-at-startup "waybar"
//spawn-at-startup "noctalia"
spawn-at-startup "hyprpaper"

cursor {
    xcursor-theme "adwaita-yes"
    xcursor-size 20
}

/-environment {
    XCURSOR_THEME "adwaita-yes"
    XCURSOR_SIZE "20"
}

input {
    keyboard {
        xkb {
            layout "br,us"
            variant ",colemak_dh_iso"
            options "grp:alt_shift_toggle"
        }
        repeat-delay 250
        repeat-rate 75
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-speed -0.875
        accel-profile "flat"
    }

    trackpoint {
    }

    focus-follows-mouse max-scroll-amount="0%"
    //warp-mouse-to-focus mode="center-xy-always"
}

gestures {
    hot-corners {
        off
    }
}

output "DP-2" {
    mode "1920x1080@180"

    variable-refresh-rate on-demand=true

    scale 1

    transform "normal"

    position x=1920 y=-90
}

layout {
    gaps 4
    // struts {
    //     left -4
    //     right -4
    //     top -4
    //     bottom -4
    // }

    center-focused-column "never"

    background-color "transparent"

    preset-column-widths {
        proportion 0.5
        proportion 0.33333
        proportion 0.66667

    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off

        width 1

        active-color "#e09d28ff"

        inactive-color "#1a1a1a00"
    }

    border {
        on

        width 1
        // active-color "#e09d28ba"
        active-color "a6a6a6ff"
        inactive-color "#a6a6a635"

        urgent-color "#9b0000"
    }

    shadow {
        on

        softness 10

        spread 2

        offset x=0 y=0

        color "#0008"
    }
}

overview {
    zoom 0.5
    backdrop-color "#778478"
}


hotkey-overlay {
    skip-at-startup
}

screenshot-path null

animations {

}

// cool proof of concept, maybe ill come back later
/-animations {
    window-open {
        custom-shader r"
        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
            float progress = niri_clamped_progress;

            // -1 no começo, 0 no final.
            float offset_y = progress - 1.0;

            // Descobre qual pixel da janela deveria estar
            // na posição que estamos desenhando.
            vec3 shifted_geo = coords_geo;
            shifted_geo.y += offset_y;

            vec3 coords_tex = niri_geo_to_tex * shifted_geo;
            vec4 color = texture2D(niri_tex, coords_tex.st);

            return color;
        }
        "
        duration-ms 250
        curve "cubic-bezier" 0.25 0.9 0.35 1.0
    }

    window-close {
        custom-shader r"
        vec4 close_color(vec3 coords_geo, vec3 size_geo) {
            float progress = niri_clamped_progress;

            // -1 no começo, 0 no final.
            float offset_y = progress;

            // Descobre qual pixel da janela deveria estar
            // na posição que estamos desenhando.
            vec3 shifted_geo = coords_geo;
            shifted_geo.y -= offset_y;

            vec3 coords_tex = niri_geo_to_tex * shifted_geo;
            vec4 color = texture2D(niri_tex, coords_tex.st);

            return color;
        }
        "
        duration-ms 250
        curve "cubic-bezier" 0.25 0.9 0.35 1.0
    }
    horizontal-view-movement {
        duration-ms 350
        curve "cubic-bezier" 0.25 0.9 0.35 1.0
    }
}

/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"
}

blur {
    passes 2
    offset 2.0
    noise 0.05
}

window-rule {
    open-maximized-to-edges false
    draw-border-with-background false

    geometry-corner-radius 0
    clip-to-geometry true

    tiled-state true
}

/-window-rule {
    match is-floating=true

    border {
        on

        width 1

        active-color "#d9ba73"
        inactive-color "#383838"
    }
}

window-rule {
    match is-active=false
    /-shadow {
        off
    }
    opacity 0.97
}

window-rule {
    match app-id="miniquad-application"
    open-floating true
}

window-rule {
    match app-id="kitty"

    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="floating-kitty"

    open-floating true

    default-column-width { proportion 0.333; }
    default-window-height { proportion 0.5; }
}

window-rule {
    match app-id="^steam$" title="^Steam$"

    /*
    open-on-output "HDMI-A-1"
    open-focused false
    */

    open-maximized true
}


window-rule {
    match app-id="steam" title="Friends List"

    open-floating true
    default-column-width { proportion 0.2; }
    default-window-height { proportion 0.7; }
}

window-rule {
    match app-id="vesktop"

    /*
    open-on-output "HDMI-A-1"
    open-focused false
    */

    open-maximized true
}

window-rule {
    match app-id="brave-origin-nightly"

    open-maximized true
}

window-rule {
    match app-id="^Spotify$"

    open-maximized true
}

window-rule {
    match app-id="^steam_app_252950$"

    open-on-output "DP-2"
}

window-rule {
    match app-id="^gimp$"

    open-maximized true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=0 y=0 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id="^waywall$" title="^waywall$"
}

layer-rule {
    match namespace="^rofi$"

    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^hyprpaper$"
    place-within-backdrop true
}

binds {

    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+Shift+T  { spawn "kitty" "--class='floating-kitty'"; }
    Mod+Space hotkey-overlay-title="Run an Application: rofi" { spawn "rofi" "-show" "drun"; }
    //Mod+Space hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }
    Mod+X hotkey-overlay-title="Rofi calc" { spawn-sh "rofi -show calc -modi calc -no-show-match -no-sort -theme ~/.config/rofi/calc.rasi"; }
    Mod+Q { spawn "brave-origin-nightly"; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "swaylock"; }
    Mod+Shift+W { spawn-sh "/home/breno/.config/waybar/scripts/launch.sh"; }

    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    Mod+O repeat=false { toggle-overview; }

    Mod+C repeat=false { close-window; }

    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+M { focus-monitor-next; }
    Mod+Shift+M { move-window-to-monitor-next; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }


    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1 focus=false; }
    Mod+Shift+2 { move-column-to-workspace 2 focus=false; }
    Mod+Shift+3 { move-column-to-workspace 3 focus=false; }
    Mod+Shift+4 { move-column-to-workspace 4 focus=false; }
    Mod+Shift+5 { move-column-to-workspace 5 focus=false; }
    Mod+Shift+6 { move-column-to-workspace 6 focus=false; }
    Mod+Shift+7 { move-column-to-workspace 7 focus=false; }
    Mod+Shift+8 { move-column-to-workspace 8 focus=false; }
    Mod+Shift+9 { move-column-to-workspace 9 focus=false; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+Ctrl+h  { consume-or-expel-window-left; }
    Mod+Ctrl+l { consume-or-expel-window-right; }

    Mod+BracketLeft  { consume-window-into-column; }
    Mod+BracketRight { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+E { maximize-column; }
    Mod+F { fullscreen-window; }

    Mod+Semicolon { maximize-window-to-edges; }

    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+N { center-column; }

    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }


    Mod+Shift+S { screenshot; }
    Print { screenshot-screen; }
    Mod+P { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Ctrl+Alt+Delete { quit; }

    Mod+Ctrl+Shift+M { power-off-monitors; }
}
